PORT=8080
# Laisser vide derrière Caddy : l'URL wss est déduite de la requête.
PUBLIC_WS_URL=
DATA_DIR=./data

TWILIO_AUTH_TOKEN=

# Groq
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Google AI Studio (Gemini Live + TTS)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore

# JEV via OpenCode Zen (le jeton public fonctionne pour le free)
JEV_API_KEY=public
JEV_MODEL=jev-1.13-free
JEV_ENDPOINT=https://opencode.ai/inference/systemone/v1/systemone

# Voix
VAD_THRESHOLD=420
VAD_SILENCE_MS=650
VAD_MIN_SPEECH_MS=280
BARGE_IN=true
HANDOFF_ENABLED=true
LOG_TRANSCRIPTS=false

PRODUCT_API_URL=http://127.0.0.1:4000
AGENT_API_KEY=dev_agent_9f3c2a7b1d8e4f60
