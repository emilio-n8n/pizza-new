# Domaines (DNS A vers le VPS avant le premier démarrage)
APP_DOMAIN=app.pizzavoice.fr
RUNTIME_DOMAIN=runtime.pizzavoice.fr

# Compte administrateur de l'Atelier (emails séparés par des virgules)
ATELIER_ADMINS=vous@example.com

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# Lien public de l'app et clé runtime → app
APP_PUBLIC_URL=http://localhost:4000
AGENT_API_KEY=dev_agent_9f3c2a7b1d8e4f60

# Groq (transcription)
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Google AI Studio (Gemini Live + TTS)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
TTS_VOICE=Kore

# JEV — DÉSACTIVÉ depuis le 15/11/2026 : Gemini Live traite seul l'appel.
# Les variables restent lues par config.ts mais ne sont plus utilisées.
JEV_API_KEY=public
JEV_MODEL=jev-1.13-free
JEV_ENDPOINT=https://opencode.ai/inference/systemone/v1/systemone

# Voix et handoff
VAD_THRESHOLD=420
VAD_SILENCE_MS=650
VAD_MIN_SPEECH_MS=280
BARGE_IN=true
HANDOFF_ENABLED=true
LOG_TRANSCRIPTS=false

# Téléphone navigateur. LAISSER VIDE : l'URL wss est déduite de l'hôte du
# navigateur et pointe sur /phone-ws (Caddy en prod, proxy de tunnel en test).
VITE_RUNTIME_WS_URL=

# --- Supabase (Postgres) -----------------------------------------------
# Le serveur utilise la clé service_role : elle contourne RLS et ne doit
# JAMAIS être exposée au navigateur ni committée.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
